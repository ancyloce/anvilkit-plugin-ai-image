{
	"name": "@anvilkit/plugin-ai-image",
	"version": "0.1.1",
	"description": "AI image generation plugin for AnvilKit Canvas Studio (text-to-image, variation, inpaint, background removal).",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./mock": {
			"import": {
				"types": "./dist/mock/index.d.ts",
				"default": "./dist/mock/index.js"
			},
			"require": {
				"types": "./dist/mock/index.d.cts",
				"default": "./dist/mock/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			},
			"require": {
				"types": "./dist/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		},
		"./mask": {
			"import": {
				"types": "./dist/mask/index.d.ts",
				"default": "./dist/mask/index.js"
			},
			"require": {
				"types": "./dist/mask/index.d.cts",
				"default": "./dist/mask/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"meta"
	],
	"license": "MIT",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@anvilkit/ui": "workspace:*",
		"@puckeditor/core": "^0.21.2",
		"konva": "^9 || ^10",
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0",
		"react-konva": "^19"
	},
	"peerDependenciesMeta": {
		"@anvilkit/ui": {
			"optional": true
		},
		"react": {
			"optional": false
		},
		"react-dom": {
			"optional": false
		},
		"@puckeditor/core": {
			"optional": false
		},
		"konva": {
			"optional": true
		},
		"react-konva": {
			"optional": true
		}
	},
	"dependencies": {
		"@anvilkit/canvas-core": "workspace:*",
		"@anvilkit/core": "workspace:*",
		"@anvilkit/utils": "workspace:*",
		"lucide-react": "^1.16.0"
	},
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"lint": "pnpm exec biome lint package.json tsconfig.json rslib.config.ts vitest.config.ts src meta",
		"format": "pnpm exec biome check --write package.json tsconfig.json rslib.config.ts vitest.config.ts src meta",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"publint": "publint",
		"size": "size-limit"
	},
	"devDependencies": {
		"@anvilkit/biome-config": "workspace:*",
		"@anvilkit/typescript-config": "workspace:*",
		"@anvilkit/ui": "workspace:*",
		"@anvilkit/vitest-config": "workspace:*",
		"@puckeditor/core": "^0.21.2",
		"@rsbuild/plugin-react": "^2.0.0",
		"@rslib/core": "^0.21.5",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"jsdom": "^29.1.1",
		"konva": "^10.3.0",
		"publint": "^0.3.21",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-konva": "^19.2.4",
		"typescript": "6.0.3",
		"vitest": "^4.1.7"
	}
}
