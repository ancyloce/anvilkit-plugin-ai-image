{
	"name": "@anvilkit/plugin-ai-image",
	"version": "0.1.4",
	"description": "AI image generation plugin for AnvilKit Canvas Studio (text-to-image, variation, inpaint, background removal).",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./mock": {
			"import": {
				"types": "./dist/mock/index.d.ts",
				"default": "./dist/mock/index.js"
			},
			"require": {
				"types": "./dist/cjs/mock/index.d.cts",
				"default": "./dist/mock/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			},
			"require": {
				"types": "./dist/cjs/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		},
		"./evaluation": {
			"import": {
				"types": "./dist/evaluation/index.d.ts",
				"default": "./dist/evaluation/index.js"
			},
			"require": {
				"types": "./dist/cjs/evaluation/index.d.cts",
				"default": "./dist/evaluation/index.cjs"
			}
		},
		"./job-session": {
			"import": {
				"types": "./dist/job/ai-image-job-session.d.ts",
				"default": "./dist/job/ai-image-job-session.js"
			},
			"require": {
				"types": "./dist/cjs/job/ai-image-job-session.d.cts",
				"default": "./dist/job/ai-image-job-session.cjs"
			}
		},
		"./telemetry": {
			"import": {
				"types": "./dist/telemetry/index.d.ts",
				"default": "./dist/telemetry/index.js"
			},
			"require": {
				"types": "./dist/cjs/telemetry/index.d.cts",
				"default": "./dist/telemetry/index.cjs"
			}
		},
		"./mask": {
			"import": {
				"types": "./dist/mask/index.d.ts",
				"default": "./dist/mask/index.js"
			},
			"require": {
				"types": "./dist/cjs/mask/index.d.cts",
				"default": "./dist/mask/index.cjs"
			}
		},
		"./post-process": {
			"import": {
				"types": "./dist/post-process/index.d.ts",
				"default": "./dist/post-process/index.js"
			},
			"require": {
				"types": "./dist/cjs/post-process/index.d.cts",
				"default": "./dist/post-process/index.cjs"
			}
		},
		"./commit": {
			"import": {
				"types": "./dist/commit/index.d.ts",
				"default": "./dist/commit/index.js"
			},
			"require": {
				"types": "./dist/cjs/commit/index.d.cts",
				"default": "./dist/commit/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"meta",
		"i18n"
	],
	"license": "MIT",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@anvilkit/ui": "workspace:*",
		"@puckeditor/core": "^0.23.0",
		"konva": "^10",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"react-konva": "^19"
	},
	"peerDependenciesMeta": {
		"@anvilkit/ui": {
			"optional": true
		},
		"react": {
			"optional": false
		},
		"react-dom": {
			"optional": false
		},
		"@puckeditor/core": {
			"optional": false
		},
		"konva": {
			"optional": true
		},
		"react-konva": {
			"optional": true
		}
	},
	"dependencies": {
		"@anvilkit/canvas-core": "workspace:*",
		"@anvilkit/core": "workspace:*",
		"@anvilkit/utils": "workspace:*",
		"lucide-react": "^1.31.0"
	},
	"scripts": {
		"build": "rslib build --lib esm && rslib build --lib cjs --no-clean",
		"dev": "rslib build --watch",
		"lint": "pnpm exec biome lint package.json tsconfig.json rslib.config.ts vitest.config.ts src meta",
		"format": "pnpm exec biome check --write package.json tsconfig.json rslib.config.ts vitest.config.ts src meta",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"publint": "publint",
		"size": "size-limit"
	},
	"devDependencies": {
		"@anvilkit/biome-config": "workspace:*",
		"@anvilkit/typescript-config": "workspace:*",
		"@anvilkit/ui": "workspace:*",
		"@anvilkit/vitest-config": "workspace:*",
		"@puckeditor/core": "^0.23.0",
		"@rsbuild/plugin-react": "^2.1.0",
		"@rslib/core": "^0.23.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "19.2.4",
		"jsdom": "^30.0.1",
		"konva": "^10.3.1",
		"publint": "^0.3.23",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-konva": "^19.2.5",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
