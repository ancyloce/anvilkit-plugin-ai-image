{
	"name": "@anvilkit/plugin-ai-image",
	"version": "0.1.0",
	"description": "AI image generation plugin for AnvilKit Canvas Studio (text-to-image, variation, inpaint, background removal).",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@puckeditor/core": "^0.21.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": false
		},
		"react-dom": {
			"optional": false
		},
		"@puckeditor/core": {
			"optional": false
		}
	},
	"dependencies": {
		"@anvilkit/canvas-core": "workspace:*",
		"@anvilkit/core": "workspace:*",
		"@anvilkit/utils": "workspace:*"
	},
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"lint": "pnpm exec biome lint package.json tsconfig.json rslib.config.ts vitest.config.ts src",
		"format": "pnpm exec biome check --write package.json tsconfig.json rslib.config.ts vitest.config.ts src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"publint": "publint",
		"size": "size-limit"
	},
	"devDependencies": {
		"@anvilkit/biome-config": "workspace:*",
		"@anvilkit/typescript-config": "workspace:*",
		"@anvilkit/vitest-config": "workspace:*",
		"@puckeditor/core": "^0.21.2",
		"@rsbuild/plugin-react": "^2.0.0",
		"@rslib/core": "^0.21.5",
		"@types/node": "^25.9.1",
		"publint": "^0.3.21",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"typescript": "6.0.3",
		"vitest": "^4.1.7"
	}
}
